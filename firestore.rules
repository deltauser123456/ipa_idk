rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParticipant(chatId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUIDs;
    }

    function otherParticipant(chatId, uid) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.participantUIDs
        .hasAny([uid])
        && uid != request.auth.uid;
    }

    match /users/{uid} {
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email;
      allow get, list: if signedIn();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /chats/{chatId} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantUIDs
        && request.resource.data.participantUIDs.size() == 2;
      allow get, list: if signedIn() && request.auth.uid in resource.data.participantUIDs;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantUIDs
        && request.resource.data.participantUIDs == resource.data.participantUIDs
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant(chatId);
        allow create: if isParticipant(chatId)
          && request.resource.data.senderUID == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;
        allow update, delete: if false;
      }

      match /calls/{callId} {
        allow read: if isParticipant(chatId);

        allow create: if isParticipant(chatId)
          && request.resource.data.keys().hasOnly([
            'callerUID', 'calleeUID', 'status', 'type', 'roomName', 'createdAt'
          ])
          && request.resource.data.callerUID == request.auth.uid
          && request.resource.data.calleeUID is string
          && otherParticipant(chatId, request.resource.data.calleeUID)
          && request.resource.data.status == 'ringing'
          && request.resource.data.type in ['audio', 'video']
          && request.resource.data.roomName == 'chat_' + chatId
          && request.resource.data.createdAt == request.time;

        allow update: if isParticipant(chatId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && (
            (
              request.auth.uid == resource.data.calleeUID
              && resource.data.status == 'ringing'
              && request.resource.data.status in ['accepted', 'declined']
            )
            ||
            (
              request.auth.uid == resource.data.callerUID
              && resource.data.status in ['ringing', 'accepted']
              && request.resource.data.status == 'ended'
            )
          );

        allow delete: if false;
      }
    }
  }
}